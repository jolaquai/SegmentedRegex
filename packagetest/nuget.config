<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- No <clear />: machine-level sources are kept, so an existing local feed (e.g. one already
       registered as "Local") keeps working. This only adds the repo's own artifacts/ directory, which is
       gitignored, so the test also works on a clean clone without touching machine configuration. -->
  <packageSources>
    <add key="SegmentedRegexArtifacts" value="..\artifacts" />
  </packageSources>
</configuration>
