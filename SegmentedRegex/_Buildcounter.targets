<Project>
  <!-- Local build numbering. Imported for Debug only: Release must stay exactly $(CoreVersion) so the
       release workflow publishes and tags a clean version. -->
  <PropertyGroup>
    <BuildCounterFile>$(MSBuildProjectDirectory)\.buildcounter</BuildCounterFile>

    <!-- Read during EVALUATION, not inside a target. Version has to be settled before evaluation ends:
         PackageVersion and the assembly-info properties are expanded then, so a Version assigned from a
         target arrives too late and Pack silently emits 1.0.0. Reading here also means every
         TargetFramework leg sees the same number instead of each advancing its own. -->
    <_BuildCounterRaw Condition="Exists('$(BuildCounterFile)')">$([System.IO.File]::ReadAllText('$(BuildCounterFile)'))</_BuildCounterRaw>
    <_BuildCounter>$(_BuildCounterRaw.Trim())</_BuildCounter>
    <_BuildCounter Condition="'$(_BuildCounter)' == ''">0</_BuildCounter>

    <Version>$(CoreVersion)-alpha$(_BuildCounter.PadLeft(3,'0'))</Version>
  </PropertyGroup>

  <!-- Advance once per build. Cross-targeting runs the outer instance with an empty TargetFramework and
       one inner instance per TFM; keying on the outer keeps a two-TFM build to a single increment.
       A build pinned to one TFM (-f) leaves the counter alone, which is fine for a local build number. -->
  <Target Name="IncrementBuildCounter" AfterTargets="Build" Condition="'$(TargetFramework)' == ''">
    <PropertyGroup>
      <_NextBuildCounter>$([MSBuild]::Add($(_BuildCounter), 1))</_NextBuildCounter>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildCounterFile)" Lines="$(_NextBuildCounter)" Overwrite="true" />
  </Target>
</Project>
