<Project>
  <!-- The generator ships inside this package rather than as its own. Two things matter here:
       it must land under analyzers/dotnet/cs/ or Roslyn never loads it as a generator, and the path
       must not reference $(TargetFramework), which is empty in the outer cross-targeting pack and was
       putting the assembly loose under lib\ (NU5101/NU5103). netstandard2.0 is pinned for the same
       reason as the ProjectReference in the .csproj. -->
  <Target Name="_AddSourceGenToPack" BeforeTargets="_GetPackageFiles">
    <!-- Build before asking for the path. GetTargetPath only reports where the assembly *would* be; on
         its own it will happily hand back a stale one built for an earlier edit or a different
         configuration, and the package then ships a generator that does not match the source. -->
    <!-- NoBuild=false override: `dotnet pack --no-build` (used by the release job) sets NoBuild=true
         as a global property, which otherwise rides along into this nested MSBuild call and makes the
         SDK refuse to run Build here (NETSDK1085) even though this project was never actually built. -->
    <MSBuild Projects="..\SegmentedRegex.SourceGen\SegmentedRegex.SourceGen.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0;NoBuild=false" />
    <MSBuild Projects="..\SegmentedRegex.SourceGen\SegmentedRegex.SourceGen.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SourceGenOutput" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_SourceGenOutput)" Pack="true" PackagePath="analyzers\dotnet\cs\" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
