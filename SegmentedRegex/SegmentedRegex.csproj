<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <CoreVersion>0.1.0</CoreVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)\_PackSourceGen.targets" />
  <Import Project="$(MSBuildProjectDirectory)\_Buildcounter.targets"
          Condition="'$(Configuration)' == 'Debug'" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <!-- Both TFM legs reference SegmentedRegex.SourceGen pinned to netstandard2.0 (see the
         ProjectReference below). Building the legs in parallel (the cross-targeting default) lets
         both legs build that shared project at once, racing on its output files (deps.json, dll) -
         "process cannot access the file ... because it is being used by another process". Build the
         legs sequentially instead; it's two small projects, the serialization cost is negligible. -->
    <BuildInParallel>false</BuildInParallel>
    <LangVersion>latest</LangVersion>
    <RollForward>LatestMajor</RollForward>
    <DebugType>portable</DebugType>
    <DebugSymbols>True</DebugSymbols>

    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles Condition="'$(Configuration)' == 'Debug'">True</EmitCompilerGeneratedFiles>

    <AnalysisMode>recommended</AnalysisMode>
    <AnalysisModePerformance>all</AnalysisModePerformance>
    <AnalysisModeInteroperability>none</AnalysisModeInteroperability>

    <!-- CA1711: the 'Ex' suffix is the library's name, not an accident.
         CA1510: ArgumentNullException.ThrowIfNull does not exist on netstandard2.0. -->
    <NoWarn>$(NoWarn);CA1711;CA1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>SegmentedRegex</RootNamespace>

    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>True</IncludeSymbols>
    <Version Condition="'$(Configuration)' == 'Release'">$(CoreVersion)</Version>

    <PackageId>$(AssemblyName)</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageDescription>Regex matching with familiar perf on segmented/multipart subjects.</PackageDescription>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jolaquai/$(AssemblyName)</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE;..\README.md" Pack="True" PackagePath="/" />

    <Using Include="System.Buffers" />
    <Using Include="System.Diagnostics" />

    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />

    <Using Include="System.Text" />
    <Using Include="System.Text.RegularExpressions" />

    <!-- Roslyn requires analyzers/generators to be netstandard2.0. Without any override, a
         multi-targeted consumer's ProjectReference forces its OWN current leg's TargetFramework
         onto the referenced project as a global property - for the net10.0 leg that's NETSDK1005
         (SourceGen only declares netstandard2.0). UndefineProperties strips TargetFramework from
         the global properties passed down instead of overriding it to a fixed value: SourceGen then
         falls back to its own single declared TFM either way, but crucially this also makes the
         global-properties set here identical to how SegmentedRegex.SourceGen.csproj is built as its own
         top-level entry in SegmentedRegex.slnx (no TargetFramework override there either). Using
         SetTargetFramework="TargetFramework=netstandard2.0" instead resolves to the same TFM but as
         a *different* global-properties set, so MSBuild treats the two as separate, undeduplicated
         build requests for the same project - which can run concurrently and race on its output
         files (deps.json etc., surfaced as MSB4018/GenerateDepsFile "being used by another
         process"). Matching the global-properties set here lets MSBuild recognize both requests as
         the same project instance and build it once. -->
    <ProjectReference Include="..\SegmentedRegex.SourceGen\SegmentedRegex.SourceGen.csproj" ReferenceOutputAssembly="false" UndefineProperties="TargetFramework" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="**/*.net.cs" />
    <None Include="**/*.net.cs" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Compile Remove="**/*.netstandard2.0.cs" />
    <None Include="**/*.netstandard2.0.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

</Project>
