<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RollForward>LatestMajor</RollForward>
    <DebugType>portable</DebugType>
    <DebugSymbols>True</DebugSymbols>

    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles Condition="'$(Configuration)' == 'Debug'">True</EmitCompilerGeneratedFiles>

    <AnalysisMode>recommended</AnalysisMode>
    <AnalysisModePerformance>all</AnalysisModePerformance>
    <AnalysisModeInteroperability>none</AnalysisModeInteroperability>

    <!-- CA1711: the 'Ex' suffix is the library's name, not an accident.
         CA1510: ArgumentNullException.ThrowIfNull does not exist on netstandard2.0. -->
    <NoWarn>$(NoWarn);CA1711;CA1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>SegmentedRegex</RootNamespace>

    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>True</IncludeSymbols>
    <Version>$(CoreVersion)</Version>

    <PackageId>$(AssemblyName)</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageDescription>Regex matching with familiar perf on segmented/multipart subjects.</PackageDescription>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jolaquai/$(AssemblyName)</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE;..\README.md" Pack="True" PackagePath="/" />

    <Using Include="System.Buffers" />
    <Using Include="System.Diagnostics" />

    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />

    <Using Include="System.Text" />
    <Using Include="System.Text.RegularExpressions" />

    <!-- Pinned, not $(TargetFramework): Roslyn requires analyzers/generators to be netstandard2.0,
         so propagating this project's TFM into it fails NETSDK1005 on the net8.0 leg. -->
    <ProjectReference Include="..\SegmentedRegex.SourceGen\SegmentedRegex.SourceGen.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\_PackSourceGen.targets" />

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="**/*.net.cs" />
    <None Include="**/*.net.cs" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Compile Remove="**/*.netstandard2.0.cs" />
    <None Include="**/*.netstandard2.0.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

</Project>
